# Copy this file to .env and fill in your own values.
# Get a Gemini API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Any random long string works. Used to sign Flask's session cookie.
FLASK_SECRET_KEY=change-this-to-a-random-secret-string

# Optional: set to "1" to enable Flask debug mode locally.
FLASK_DEBUG=0

# Used for YouTube comment sentiment analysis. Enable the "YouTube Data
# API v3" on a Google Cloud project and create an API key at
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-data-api-key-here
