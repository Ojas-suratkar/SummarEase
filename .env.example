# Copy this file to .env and fill in your own values.
# Get a Gemini API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Any random long string works. Used to sign Flask's session cookie AND
# every account's password hash's salt derivation via Werkzeug -- treat
# it as a real secret, especially once this is deployed.
FLASK_SECRET_KEY=change-this-to-a-random-secret-string

# Optional. Leave unset for local dev -- the app falls back to a single
# SQLite file at instance/app.db. Set this to a Postgres connection string
# once deployed (Render/Railway/Heroku/Fly's Postgres add-ons inject this
# automatically when you attach a database -- just copy it in verbatim,
# postgres:// or postgresql:// both work).
DATABASE_URL=

# Optional: set to "1" once this is actually served over HTTPS (most
# hosts terminate TLS in front of the app) so the session cookie gets the
# Secure flag. Leave "0" for local dev over plain http://localhost.
FORCE_HTTPS=0

# Optional: set to "1" to enable Flask debug mode locally.
FLASK_DEBUG=0

# Used for YouTube comment sentiment analysis. Enable the "YouTube Data
# API v3" on a Google Cloud project and create an API key at
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-data-api-key-here
